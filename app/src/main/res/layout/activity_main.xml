<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">


    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/skin_logo"
        android:scaleType="centerInside"
        android:contentDescription="SkinGuard App Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to SkinGuard"
        android:textColor="#1E293B"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="Select an option below to proceed"
        android:textColor="#64748B"
        android:textSize="14sp" />


    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#0284C7"
        android:text="Scan Skin Lesion (AI)"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_scan_btn"
        android:drawablePadding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>


    <Button
        android:id="@+id/btnChatbot"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#0EA5E9"
        android:text="Skincare Chatbot Assistant"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_chat_btn"
        android:drawablePadding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>

</LinearLayout>