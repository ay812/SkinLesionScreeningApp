<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.skinlesionscreeningapp">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SkinGuard AI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkinLesionScreeningApp">

        <!-- Splash Activity (Launcher Activity) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Activity -->
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- AI Scanner Activity -->
        <activity android:name=".ScannerActivity" android:exported="false" />

        <!-- Chatbot Activity -->
        <activity android:name=".ChatbotActivity" android:exported="false" />

    </application>

</manifest>